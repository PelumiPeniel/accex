PORT=4000
JWT_SECRET=change-this-secret-in-production
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500

# PostgreSQL connection. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accex

# Set to "true" if your database provider requires SSL (most managed
# providers — e.g. Heroku, Render, RDS — do). Leave unset/false for a
# local PostgreSQL install.
PGSSL=false

# --- Active Directory (optional) --------------------------------------
# Only used when "Active Directory lookup" is turned on in Global
# Settings. Lets staff-number fields auto-fill First name / Last name.
# Leave all of these unset to keep the feature fully inert — the toggle
# in Global Settings will simply do nothing (silently) if these aren't
# configured.
# AD_URL=ldaps://dc01.yourcompany.local:636
# AD_BASE_DN=DC=yourcompany,DC=local
# AD_BIND_DN=svc-accex@yourcompany.local
# AD_BIND_PASSWORD=
# AD_STAFF_NUMBER_ATTR=employeeID
